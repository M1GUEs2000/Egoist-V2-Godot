[gd_resource type="Resource" script_class="AttackSequence" format=3 uid="uid://bnvtkfyxgglnp"]

[ext_resource type="Script" uid="uid://b0xd72invappo" path="res://data/attack_clip.gd" id="1_clip"]
[ext_resource type="Script" uid="uid://b1755lpansqbo" path="res://data/attack_step.gd" id="2_step"]
[ext_resource type="Script" uid="uid://b1oxel8llcohe" path="res://data/attack_sequence.gd" id="3_sequence"]
[ext_resource type="Script" uid="uid://df6a6rp7vamdn" path="res://data/attack_movement_profile.gd" id="4_movement"]
[ext_resource type="Script" uid="uid://w0b3i18w442a" path="res://data/stun_settings.gd" id="4_whdhe"]
[ext_resource type="Script" uid="uid://cprdodv3kypq1" path="res://data/push_settings.gd" id="5_push"]

[sub_resource type="Resource" id="Resource_clip_a"]
script = ExtResource("1_clip")
clip = &"Sword_Regular_A"

[sub_resource type="Resource" id="Resource_m478f"]
script = ExtResource("4_whdhe")
grounded = 10.0
metadata/_custom_type_script = "uid://w0b3i18w442a"

[sub_resource type="Resource" id="Resource_step_1"]
script = ExtResource("2_step")
clip = SubResource("Resource_clip_a")
stun = SubResource("Resource_m478f")
