[gd_resource type="Resource" script_class="AttackSequence" format=3]

[ext_resource type="Script" uid="uid://b0xd72invappo" path="res://data/attack_clip.gd" id="1_clip"]
[ext_resource type="Script" uid="uid://b1755lpansqbo" path="res://data/attack_step.gd" id="2_step"]
[ext_resource type="Script" uid="uid://b1oxel8llcohe" path="res://data/attack_sequence.gd" id="3_sequence"]
[ext_resource type="Script" uid="uid://df6a6rp7vamdn" path="res://data/attack_movement_profile.gd" id="4_movement"]
[ext_resource type="Script" uid="uid://dsps3sxfd8wmx" path="res://data/mover_settings.gd" id="5_mover"]

[sub_resource type="Resource" id="Resource_clip_plunge"]
script = ExtResource("1_clip")
clip = &"Sword_Heavy_Combo"
start_time = 2.4
end_time = 2.7

[sub_resource type="Resource" id="Resource_player_plunge"]
script = ExtResource("5_mover")
direction = 1
distance = 100.0
speed = 30.0
acceleration = 20.0
stop_on = 3
mode = 1

[sub_resource type="Resource" id="Resource_enemy_plunge"]
script = ExtResource("5_mover")
direction = 1
distance = 100.0
speed = 30.0
acceleration = 20.0
stop_on = 3

[sub_resource type="Resource" id="Resource_profile_plunge"]
script = ExtResource("4_movement")
player_travel = SubResource("Resource_player_plunge")
player_travel_at_window_end = true
enemy_travel = SubResource("Resource_enemy_plunge")
enemy_travel_at = 2
enemy_travel_aligns_y = true

[sub_resource type="Resource" id="Resource_step_plunge"]
script = ExtResource("2_step")
clip = SubResource("Resource_clip_plunge")
movement = SubResource("Resource_profile_plunge")
advances = false
choreography = &"air_finisher"

[resource]
script = ExtResource("3_sequence")
steps = Array[ExtResource("2_step")]([SubResource("Resource_step_plunge")])
auto_chain = true
recovery = 0.0
