[gd_resource type="Resource" script_class="AttackSequence" format=3 uid="uid://b6o7mn3n42fdr"]

[ext_resource type="Script" uid="uid://b0xd72invappo" path="res://data/attack_clip.gd" id="1_clip"]
[ext_resource type="Script" uid="uid://b1755lpansqbo" path="res://data/attack_step.gd" id="2_step"]
[ext_resource type="Script" uid="uid://b1oxel8llcohe" path="res://data/attack_sequence.gd" id="3_sequence"]
[ext_resource type="Script" uid="uid://df6a6rp7vamdn" path="res://data/attack_movement_profile.gd" id="4_movement"]
[ext_resource type="Script" uid="uid://dsps3sxfd8wmx" path="res://data/mover_settings.gd" id="5_mover"]

[sub_resource type="Resource" id="Resource_clip_spin"]
script = ExtResource("1_clip")
clip = &"Sword_Regular_C"
speed_bonus = 100.0

[sub_resource type="Resource" id="Resource_enemy_hang"]
script = ExtResource("5_mover")
direction = 2
distance = 1.0
float_duration = 0.3

[sub_resource type="Resource" id="Resource_player_travel"]
script = ExtResource("5_mover")
direction = 2
distance = 1.0
stop_on = 3
float_duration = 0.3

[sub_resource type="Resource" id="Resource_profile_spin"]
script = ExtResource("4_movement")
player_travel = SubResource("Resource_player_travel")
enemy_travel = SubResource("Resource_enemy_hang")
rt_travel_speed_bonus = 50.0
rt_travel_acceleration_bonus = 50.0
rt_animation_speed_bonus = 50.0
rt_player_hang_bonus = 25.0
rt_enemy_hang_bonus = 30.0
overrides_air_hit = true

[sub_resource type="Resource" id="Resource_step_spin"]
script = ExtResource("2_step")
clip = SubResource("Resource_clip_spin")
movement = SubResource("Resource_profile_spin")
repeat = 2
repeat_with_meter = 4
advances = false

[resource]
script = ExtResource("3_sequence")
steps = Array[ExtResource("2_step")]([SubResource("Resource_step_spin")])
auto_chain = true
recovery = 0.0
