[gd_resource type="Resource" script_class="AttackSequence" format=3 uid="uid://rmsrsx1p06k2"]

[ext_resource type="Resource" uid="uid://bmuejelf1t0qq" path="res://data/sword_air_charged_y_knock.tres" id="1_knock"]
[ext_resource type="Script" uid="uid://b0xd72invappo" path="res://data/attack_clip.gd" id="2_clip"]
[ext_resource type="Script" uid="uid://b1755lpansqbo" path="res://data/attack_step.gd" id="3_step"]
[ext_resource type="Script" uid="uid://b1oxel8llcohe" path="res://data/attack_sequence.gd" id="4_sequence"]

[sub_resource type="Resource" id="Resource_clip_a"]
script = ExtResource("2_clip")
clip = &"Sword_Regular_A"

[sub_resource type="Resource" id="Resource_step_1"]
script = ExtResource("3_step")
clip = SubResource("Resource_clip_a")
damage_scale = 0.6
choreography = &"air_diagonal_l"

[sub_resource type="Resource" id="Resource_clip_b"]
script = ExtResource("2_clip")
clip = &"Sword_Regular_B"

[sub_resource type="Resource" id="Resource_step_2"]
script = ExtResource("3_step")
clip = SubResource("Resource_clip_b")
damage_scale = 0.6
choreography = &"air_diagonal_r"

[sub_resource type="Resource" id="Resource_clip_heavy"]
script = ExtResource("2_clip")
clip = &"Sword_Heavy_Combo"
start_time = 2.4
end_time = 2.7

[sub_resource type="Resource" id="Resource_step_3"]
script = ExtResource("3_step")
clip = SubResource("Resource_clip_heavy")
movement = ExtResource("1_knock")
choreography = &"air_finisher"

[resource]
script = ExtResource("4_sequence")
steps = Array[ExtResource("3_step")]([SubResource("Resource_step_1"), SubResource("Resource_step_2"), SubResource("Resource_step_3")])
step_time = 0.2
auto_chain = true
